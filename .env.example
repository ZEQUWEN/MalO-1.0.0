# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY
DEEPSEEK_API_KEY=MY_DEEPSEEK_API_KEY

# ---------------------------------------------------------------- billing --
# Base URL of the MalO payment gateway (see server/). The APK talks only to
# this host: no acquirer or CryptoBot secret is ever compiled into the app.
# Leave the placeholder to build an offline/demo APK.
MALO_GATEWAY_URL=MY_MALO_GATEWAY_URL

# Shared secret sent as the X-MalO-Client-Key header. Must match
# MALO_CLIENT_KEY on the gateway. Leave the placeholder for open dev gateways.
MALO_CLIENT_KEY=MY_MALO_CLIENT_KEY
