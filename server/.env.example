# Runtime only. Never put secrets in the APK, logs, source control, or chat.
PORT=8080
MALO_PUBLIC_URL=https://malo.up.railway.app
MALO_DATA_DIR=./.data

# PostgreSQL URL supplied by Railway. Apply schema explicitly with npm run db:migrate.
DATABASE_URL=
# Random secret >= 32 bytes, used to protect short-lived email codes.
MALO_AUTH_PEPPER=
# SMTP supports smtps:// (implicit TLS) or smtp:// (STARTTLS required).
SMTP_URL=
MALO_MAIL_FROM=

# Ko-fi verification token is a shared bearer secret, not a signature.
# Register https://<your-domain>/api/v2/webhooks/kofi at Ko-fi.
KOFI_VERIFICATION_TOKEN=
KOFI_PAGE_URL=https://ko-fi.com/YOUR_PAGE
MALO_PRICE_USD=4.99
MALO_PLAN_PERIOD_DAYS=30

# DeepSeek server-side only.
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_REQUEST_TIMEOUT_MS=30000
MALO_AI_MAX_INPUT_LENGTH=500
MALO_AI_MAX_HISTORY_BLOCKS=12
MALO_AI_MAX_CONTEXT_CHARS=12000
MALO_AI_MAX_OUTPUT_TOKENS=200
