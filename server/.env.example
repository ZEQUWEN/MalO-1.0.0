# ---------------------------------------------------------------------------
# MalO payment gateway configuration.
# Copy to server/.env (never commit the real values).
# ---------------------------------------------------------------------------

PORT=8080

# Public HTTPS origin of this gateway. Used to print the webhook URLs you must
# register with the providers.
MALO_PUBLIC_URL=https://malo.up.railway.app

# Shared secret the Android app must send in X-MalO-Client-Key.
# Leave empty to accept unauthenticated app calls (local development only).
MALO_CLIENT_KEY=

# Where the JSON state file lives (subscriptions, invoices, card tokens).
MALO_DATA_DIR=./.data

# Set to 1 to run both providers in mock mode (no outbound calls). Used by tests.
MALO_MOCK_PROVIDERS=0

# ------------------------------------------------------------------- plan --
MALO_PLAN_PERIOD_DAYS=30
MALO_PRICE_RUB=499.00
MALO_PRICE_USD=4.99

# --------------------------------------------------------------- ЮKassa ----
# Dashboard -> Интеграция -> Ключи API.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE=https://api.yookassa.ru/v3
# Deep link the user returns to after 3-D Secure.
YOOKASSA_RETURN_URL=malo://payment/return
# Reject notifications coming from outside YooKassa's documented subnets.
YOOKASSA_VERIFY_NETWORK=1
# Webhook to register in the YooKassa dashboard:
#   https://malo.up.railway.app/api/webhooks/yookassa
#   events: payment.succeeded, payment.canceled, refund.succeeded

# ------------------------------------------------------------- CryptoBot ---
# Telegram @CryptoBot -> Crypto Pay -> My Apps -> API Token.
CRYPTOBOT_TOKEN=
# Mainnet: https://pay.crypt.bot/api   Testnet: https://testnet-pay.crypt.bot/api
CRYPTOBOT_API_BASE=https://pay.crypt.bot/api
CRYPTOBOT_PAID_BTN_URL=https://t.me/CryptoBot
CRYPTOBOT_INVOICE_EXPIRES_IN=3600
CRYPTOBOT_WEBHOOK_MAX_AGE=300
# Webhook to register in @CryptoBot (Crypto Pay -> My Apps -> Webhooks):
#   https://malo.up.railway.app/api/webhooks/cryptobot
